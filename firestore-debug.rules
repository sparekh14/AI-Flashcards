rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // TEMPORARY DEBUG RULES - VERY PERMISSIVE
    // Use these temporarily to debug, then switch to production rules
    match /users/{userId} {
      // Allow all operations - no restrictions for debugging
      allow read, write, delete: if true;
      
      // Allow access to user's flashcard collections
      match /{document=**} {
        // Allow all operations without restrictions
        allow read, write, delete: if true;
      }
    }
    
    // Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
} 