rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Temporary development rules - allow authenticated users to access their own data
    // Note: This is less secure and should be replaced with proper backend validation
    match /users/{userId} {
      allow read, write: if true; // Temporarily allow all access for development
      
      // Allow access to user's flashcard collections
      match /{document=**} {
        allow read, write: if true; // Temporarily allow all access for development
      }
    }
    
    // Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
} 